# Environment Configuration
# Skopiuj ten plik do .env i ustaw swoje wartości

# ===== ŚRODOWISKO =====
# STG lub PRD
ENVIRONMENT=STG

# Site Name (obowiązkowe dla API)
SITE_NAME=

# ===== API URLS =====
# External API
STG_EXTERNAL_API_URL=https://kwi2-stg.jemsms.corp.jabil.org/api-external-api
PRD_EXTERNAL_API_URL=https://kwi-prd.jemsms.corp.jabil.org/api-external-api

# Mendix API
STG_MENDIX_API_URL=https://kwi2-stg.jemsms.corp.jabil.org/mendix
PRD_MENDIX_API_URL=https://kwi-prd.jemsms.corp.jabil.org/mendix

# ===== CREDENTIALS =====
# External API - WPISZ SWOJE DANE
EXTERNAL_API_USERNAME=
EXTERNAL_API_PASSWORD=

# ===== TOKENS =====
USER_TOKEN=
MENDIX_TOKEN=

# ===== USER CONTEXT =====
# WPISZ SWOJE DANE
USER_ID=
USER_NAME=
USER_LOGIN=
USER_EMAIL=
EMPLOYEE_NUMBER=
